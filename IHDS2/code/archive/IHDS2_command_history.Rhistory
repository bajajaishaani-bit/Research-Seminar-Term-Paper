# ============================================================
# FIX SOCIAL CAPITAL VARIABLES IN IHDS-II
# ============================================================
# Confirm binary ME variables exist
me_bin <- paste0("ME", 1:12, "_bin")
stopifnot(
all(me_bin %in% names(ihds2))
)
# Number of valid ME answers for each household
ihds2[
,
n_social_answered :=
rowSums(
!is.na(as.matrix(.SD))
),
.SDcols = me_bin
]
# Simple count: number of memberships
ihds2[
,
social_capital_count :=
rowSums(
as.matrix(.SD),
na.rm = TRUE
),
.SDcols = me_bin
]
# Index: proportion of available organizations/groups
# in which household reports membership
ihds2[
,
social_capital_index :=
rowMeans(
as.matrix(.SD),
na.rm = TRUE
),
.SDcols = me_bin
]
# If household answered none of the ME questions,
# social capital should be missing
ihds2[
n_social_answered == 0,
`:=`(
social_capital_count = NA_real_,
social_capital_index = NA_real_
)
]
summary(ihds2$social_capital_count)
summary(ihds2$social_capital_index)
sum(is.na(ihds2$social_capital_index))
table(
ihds2$social_capital_count,
useNA = "ifany"
)
View(social_stats_ihds2)
View(ihds2)
social_stats_ihds2 <- data.table(
variable = "Social capital index",
observations =
sum(!is.na(ihds2$social_capital_index)),
mean =
mean(
ihds2$social_capital_index,
na.rm = TRUE
),
standard_deviation =
sd(
ihds2$social_capital_index,
na.rm = TRUE
),
minimum =
min(
ihds2$social_capital_index,
na.rm = TRUE
),
maximum =
max(
ihds2$social_capital_index,
na.rm = TRUE
)
)
social_stats_ihds2
