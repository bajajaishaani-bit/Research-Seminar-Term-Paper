# ============================================================
# STEP 11: IDENTIFY CONTROL VARIABLES
# ============================================================
# Get variable labels stored in IHDS-II
var_labels <- attr(ihds2, "variable.labels")
# If labels were lost during merge, get them from hh
if (is.null(var_labels)) {
var_labels <- attr(hh, "variable.labels")
}
# Build searchable dictionary
variable_dictionary <- data.table(
variable = names(var_labels),
label = as.character(var_labels)
)
View(variable_dictionary)
find_var <- function(pattern) {
variable_dictionary[
grepl(
pattern,
paste(variable, label),
ignore.case = TRUE
)
]
}
cat("\n===== HOUSEHOLD SIZE =====\n")
print(find_var("household size|number of persons|persons|members"))
cat("\n===== INCOME =====\n")
print(find_var("total income|household income"))
cat("\n===== URBAN / RURAL =====\n")
print(find_var("urban|rural"))
cat("\n===== CASTE =====\n")
print(find_var("caste|jati"))
cat("\n===== RELIGION =====\n")
print(find_var("religion"))
cat("\n===== LAND =====\n")
print(find_var("land owned|land ownership|own land"))
cat("\n===== HOUSEHOLD HEAD =====\n")
print(find_var("household head|head of household"))
cat("\n===== EDUCATION =====\n")
print(find_var("education|schooling|years of education"))
candidate_names <- c(
"NPERSONS",
"INCOME",
"HHASSETS",
"URBAN",
"IDHH",
"WT",
"FWT"
)
candidate_names[candidate_names %in% names(ihds2)]
for(v in candidate_names[candidate_names %in% names(ihds2)]) {
cat("\n============================\n")
cat(v, "\n")
cat("============================\n")
if(!is.null(var_labels) && v %in% names(var_labels)) {
print(var_labels[[v]])
}
print(summary(ihds2[[v]]))
}
